<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Description>Azure Key Vault as a secrets source for ConfigTransform.Cli (keyvault://vault[/secret] in a layer's secrets, or a resource's replace) — the only project with Azure dependencies. See docs/KEYVAULT_SECRETS_DESIGN.md.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ConfigTransform.Secrets.AzureKeyVault.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConfigTransform.Core\ConfigTransform.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.2" />
  </ItemGroup>

</Project>
