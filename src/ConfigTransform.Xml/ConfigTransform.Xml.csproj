  <ItemGroup>
    <PackageReference Include="Microsoft.Web.Xdt" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConfigTransform.Core\ConfigTransform.Core.csproj" />
  </ItemGroup>

</Project>
