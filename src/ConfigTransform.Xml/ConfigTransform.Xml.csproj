<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>configtransform-xml</ToolCommandName>
    <PackageId>ConfigTransform.Xml</PackageId>
    <Description>Base + Environments + Clients layered XDT transform resolution for App.config, Web.config, and other XML config files. See CONFIG_MANAGEMENT.md §5.2 and §6.</Description>
