<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <compilation xdt:Transform="SetAttributes" debug="false" />
    <customErrors xdt:Transform="SetAttributes" mode="RemoteOnly" />
  </system.web>
  <system.webServer>
    <rewrite>
      <rules>
        <rule xdt:Transform="SetAttributes" xdt:Locator="Match(name)" name="HTTPS Redirect" enabled="true" />
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
