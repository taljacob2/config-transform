<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Redirect" enabled="false" stopProcessing="true">
          <match url="(.*)" />
        </rule>
        <rule name="Redirect" enabled="false" stopProcessing="false">
          <match url="(.*)" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
